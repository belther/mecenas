    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "2.1.0",
    "convex": "1.51.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.73",
    "typescript": "^5.9",
    "vitest": "^5.1.1"
  }
}
