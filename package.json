{
  "name": "mecenas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "deploy:build": "convex deploy --cmd \"npm run build\"",
    "payments:probe": "node --env-file-if-exists=.env.local scripts/abacatepay-probe.mjs",
